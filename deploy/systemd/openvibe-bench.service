[Unit]
Description=OpenVibe.Bench — the shared AI benchmark engine
After=network.target

[Service]
Type=simple
User=openvibe
EnvironmentFile=/etc/openvibe/bench.env
ExecStart=/usr/bin/node /opt/openvibe/bench/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
