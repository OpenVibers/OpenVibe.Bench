# OpenVibe.Bench — production: /etc/openvibe/bench.env. Only variable NAMES appear in code and docs.
NODE_ENV=production
PORT=5230
HOST=127.0.0.1
BASE_URL=https://bench.openvibe.services
TRUST_PROXY=2

# PostgreSQL (ADR-035). DATABASE_URL serves, DATABASE_DIRECT_URL migrates (owner role).
DATABASE_URL=
DATABASE_DIRECT_URL=
# Development fallback (no DATABASE_URL): embedded PGlite.
BENCH_PGLITE_DIR=

# OpenVibe.Network SSO/JWKS.
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
OV_NETWORK_ISSUER=https://openvibe.network
OV_OAUTH_CLIENT_ID=bench
OV_OAUTH_CLIENT_SECRET=
OV_OAUTH_REDIRECT_URI=https://bench.openvibe.services/auth/callback
OV_SESSION_AUDIENCE=openvibe.network
BENCH_AUDIENCE=openvibe.bench
COOKIE_SECURE=true

# OpenVibe.AI (client credentials, audience openvibe.ai, scope ai.run.create; Network grants ai.generate ns).
OV_AI_INTERNAL_URL=http://127.0.0.1:4700
BENCH_AI_AUDIENCE=openvibe.ai
BENCH_AI_SCOPE=ai.run.create
BENCH_MODELS=

# Bench budgets.
BENCH_ROUNDS_PER_DAY=3
BENCH_ROUNDS_DAILY=20
BENCH_EVALS_PER_DAY=20

# OpenVibe.Events outbox and account export/deletion.
BENCH_EVENTS_URL=
BENCH_EVENTS_SECRET=
BENCH_EVENTS_SCOPE=events.event.publish

# Optional Valkey for shared rate counters.
VALKEY_URL=
VALKEY_PREFIX=ov:bench:
